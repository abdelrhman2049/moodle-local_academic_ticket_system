{{!
    @template local_academic_ticket_system/view

    Example context (json):
    {
        "home_url": "#",
        "sesskey": "12345",
        "has_manage_capability": true,
        "ticketid": "1",
        "ticket": {
            "id": "1",
            "title": "Need help with login",
            "created_by": "John Doe",
            "creator_profile_url": "#",
            "category": "IT Support",
            "created_at": "May 21, 2026",
            "priority_urgent": false,
            "priority_high": true,
            "priority_medium": false,
            "priority_low": false,
            "priority_label": "High",
            "status_class": "bg-green-100 text-green-700",
            "translated_status": "Open",
            "description": "<p>I cannot log into the portal since yesterday.</p>",
            "status_closed": false,
            "status": "open",
            "has_attachments": true,
            "attachments": [
                {
                    "download_url": "#",
                    "icon": "<i class=\"fas fa-file-pdf\"></i>",
                    "name": "error_log.pdf"
                }
            ]
        },
        "replies": [
            {
                "is_manager_reply": true,
                "user": "Support Team",
                "time": "May 21, 2026 - 10:00 AM",
                "message": "<p>We are checking this issue right now.</p>",
                "has_reply_attachments": false
            }
        ],
        "can_rate": true,
        "rating_options": [
            {"val": "1"}, {"val": "2"}, {"val": "3"}, {"val": "4"}, {"val": "5"}
        ],
        "has_feedback": false,
        "is_assigned": true,
        "assigned_user_name": "Admin Manager",
        "categories": [
            {
                "id": "1",
                "title": "IT Support",
                "is_selected": true
            }
        ],
        "assignable_users": [
            {
                "id": "2",
                "fullname": "Support Agent",
                "is_selected": false
            }
        ],
        "internal_notes": [],
        "latest_tickets": [],
        "has_ticket_log": false
    }
}}
<div class="ats-container relative">
    <div id="imageModal" class="ats-image-modal" onclick="closeImageModal()">
        <span class="ats-close-btn" onclick="closeImageModal()">&times;</span>
        <a id="modalDownload" href="#" download class="ats-download-btn">
            <i class="fas fa-download"></i>
        </a>
        <img id="modalImage" alt="Modal Image" src="about:blank" onclick="event.stopPropagation()">
    </div>

    <div class="container mx-auto p-4 sm:p-6 lg:p-10 max-w-7xl relative z-10 min-h-screen flex flex-col">

        <header class="glass-panel rounded-3xl p-6 mb-6 flex flex-col md:flex-row items-center justify-between gap-6 hover:shadow-2xl">
            <div class="flex items-center gap-6 w-full md:w-auto">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center shadow-lg shadow-brand text-white bg-primary-solid">
                    <i class="fas fa-ticket-alt text-3xl"></i>
                </div>
                <div class="flex-1">
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-800 flex items-center gap-2 flex-wrap">
                        {{#str}}viewticket, local_academic_ticket_system{{/str}}
                        <span class="text-secondary-solid bg-brand-light px-3 py-1 rounded-lg text-xl border border-brand-light">#{{ticket.id}}</span>
                    </h1>
                    <p class="text-gray-500 font-medium truncate max-w-md mt-1">{{ticket.title}}</p>
                </div>
            </div>

            <a href="{{home_url}}" class="glass-card px-6 py-3 rounded-2xl flex items-center gap-2 text-gray-700 font-bold hover-text-secondary hover:bg-white transition-all text-decoration-none">
                <i class="fas fa-arrow-left"></i>
                {{#str}}return_home, local_academic_ticket_system{{/str}}
            </a>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-{{#has_manage_capability}}3{{/has_manage_capability}}{{^has_manage_capability}}1{{/has_manage_capability}} gap-8">

            <div class="lg:col-span-{{#has_manage_capability}}2{{/has_manage_capability}}{{^has_manage_capability}}1{{/has_manage_capability}} space-y-8">

                <div class="glass-panel rounded-3xl p-8 relative overflow-hidden">
                    <div class="absolute -top-10 -left-10 w-40 h-40 bg-brand-light rounded-full blur-2xl pointer-events-none"></div>

                    <h2 class="text-2xl font-extrabold text-gray-800 mb-6 flex items-center pb-4 border-b border-gray-200/50 relative z-10">
                        <i class="fas fa-info-circle text-primary-solid mr-3 text-2xl"></i> {{#str}}ticket_details_heading, local_academic_ticket_system{{/str}}
                    </h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-12 mb-8 relative z-10">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-brand-light flex items-center justify-center text-primary-solid"><i class="fas fa-id-badge"></i></div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase">{{#str}}ticket_id_label, local_academic_ticket_system{{/str}}</p>
                                <p class="text-gray-800 font-bold">#{{ticket.id}}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-brand-light flex items-center justify-center text-secondary-solid"><i class="fas fa-user-circle"></i></div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase">{{#str}}user_name_label, local_academic_ticket_system{{/str}}</p>
                                <p class="text-gray-800 font-bold">
                                    <a href="{{ticket.creator_profile_url}}" class="text-gray-800 hover:underline hover-text-secondary text-decoration-none transition-colors" title="{{#str}}view_profile, local_academic_ticket_system{{/str}}">{{ticket.created_by}} <i class="fa-solid fa-arrow-up-right-from-square"></i> </a>
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-brand-light flex items-center justify-center text-primary-solid"><i class="fas fa-layer-group"></i></div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase">{{#str}}ticket_department_label, local_academic_ticket_system{{/str}}</p>
                                <p class="text-gray-800 font-bold">{{ticket.category}}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-brand-light flex items-center justify-center text-secondary-solid"><i class="fas fa-calendar-alt"></i></div>
                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase">{{#str}}created_at, local_academic_ticket_system{{/str}}</p>
                                <p class="text-gray-800 font-bold">{{ticket.created_at}}</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center
                                {{#ticket.priority_urgent}}bg-red-100 text-red-600{{/ticket.priority_urgent}}
                                {{#ticket.priority_high}}bg-orange-100 text-orange-600{{/ticket.priority_high}}
                                {{#ticket.priority_medium}}bg-blue-100 text-blue-600{{/ticket.priority_medium}}
                                {{#ticket.priority_low}}bg-gray-100 text-gray-500{{/ticket.priority_low}}">

                                <i class="fas {{#ticket.priority_urgent}}fa-fire-alt{{/ticket.priority_urgent}}{{^ticket.priority_urgent}}fa-flag{{/ticket.priority_urgent}}"
                                   aria-hidden="true"></i>
                            </div>

                            <div>
                                <p class="text-xs text-gray-400 font-bold uppercase leading-none mb-1">
                                    {{#str}}priority, local_academic_ticket_system{{/str}}
                                </p>
                                <p class="text-sm font-extrabold leading-none
                                    {{#ticket.priority_urgent}}text-red-700{{/ticket.priority_urgent}}
                                    {{^ticket.priority_urgent}}text-gray-800{{/ticket.priority_urgent}}">
                                    {{ticket.priority_label}}
                                </p>
                            </div>
                        </div>

                        <div class="md:col-span-2 mt-2">
                            <p class="text-xs text-gray-400 font-bold uppercase mb-2">{{#str}}ticket_status_label, local_academic_ticket_system{{/str}}</p>
                            <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-bold shadow-sm {{ticket.status_class}}">
                                {{ticket.translated_status}}
                            </span>
                        </div>
                    </div>

                    <div class="bg-white/40 rounded-2xl p-6 border border-white/50 relative z-10">
                        <p class="text-sm font-bold text-gray-500 uppercase mb-3 flex items-center gap-2">
                            <i class="fas fa-align-left text-secondary-solid"></i> {{#str}}ticket_description_label, local_academic_ticket_system{{/str}}
                        </p>
                        <div class="prose max-w-none text-gray-700 leading-relaxed">
                            {{{ticket.description}}}
                        </div>
                    </div>

                    {{#ticket.has_attachments}}
                        <div class="mt-8 relative z-10">
                            <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                                <i class="fas fa-paperclip text-primary-solid"></i> {{#str}}attachments_heading, local_academic_ticket_system{{/str}}
                            </h3>
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                                {{#ticket.attachments}}
                                    {{#is_image}}
                                        <div onclick="openImageModal('{{download_url}}')" class="glass-card p-2 rounded-xl flex flex-col items-center justify-center group cursor-pointer hover-border-secondary transition-all overflow-hidden relative min-h-[100px]">
                                            <div class="absolute inset-0">
                                                <img src="{{download_url}}" class="w-full h-full object-cover opacity-50 group-hover:opacity-100 transition-opacity duration-300" alt="{{name}}">
                                            </div>
                                            <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-300"></div>
                                            <i class="fas fa-search-plus text-white text-3xl drop-shadow-md z-10 opacity-0 group-hover:opacity-100 transition-opacity scale-50 group-hover:scale-100 duration-300"></i>
                                            <div class="absolute bottom-0 inset-x-0 bg-black/70 backdrop-blur-sm p-1 z-10">
                                                <p class="text-[10px] font-bold text-white truncate text-center">{{name}}</p>
                                            </div>
                                        </div>
                                    {{/is_image}}

                                    {{#is_audio}}
                                        <div class="glass-card p-3 rounded-xl flex flex-col justify-center gap-2 hover-border-secondary transition-all col-span-1 sm:col-span-2 md:col-span-1">
                                            <p class="text-xs font-bold text-gray-700 truncate" title="{{name}}"><i class="fas fa-microphone text-primary-solid mr-1"></i> {{name}}</p>
                                            <audio controls class="w-full ats-audio-player">
                                                <source src="{{download_url}}">
                                            </audio>
                                        </div>
                                    {{/is_audio}}

                                    {{^is_image}}
                                        {{^is_audio}}
                                            <a href="{{download_url}}" target="_blank" class="glass-card p-3 rounded-xl flex items-center gap-3 group text-decoration-none hover-border-secondary transition-all">
                                                <div class="w-10 h-10 bg-brand-light rounded-lg flex items-center justify-center text-primary-solid group-hover:text-secondary-solid group-hover:scale-110 transition-transform">
                                                    {{{icon}}}
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-sm font-bold text-gray-700 truncate group-hover-text-secondary transition-colors">{{name}}</p>
                                                    <p class="text-xs text-gray-400">{{#str}}click_to_download, local_academic_ticket_system{{/str}}</p>
                                                </div>
                                            </a>
                                        {{/is_audio}}
                                    {{/is_image}}
                                {{/ticket.attachments}}
                            </div>
                        </div>
                    {{/ticket.has_attachments}}
                </div>

                <div class="glass-panel rounded-3xl p-8">
                    <h2 class="text-2xl font-extrabold text-gray-800 mb-8 flex items-center">
                        <i class="fas fa-comments text-secondary-solid mr-3 text-2xl"></i> {{#str}}replies_heading, local_academic_ticket_system{{/str}}
                    </h2>

                    {{#replies}}
                        <div class="reply-card {{#is_manager_reply}}reply-card-admin{{/is_manager_reply}}{{^is_manager_reply}}reply-card-user{{/is_manager_reply}} hover:shadow-lg">
                            <div class="flex items-center justify-between mb-4 pb-2 border-b border-gray-400/20">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold {{#is_manager_reply}}bg-primary-solid{{/is_manager_reply}}{{^is_manager_reply}}bg-yellow-500{{/is_manager_reply}}">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold text-gray-800">{{user}}</p>
                                        <p class="text-xs text-gray-500">{{#is_manager_reply}}{{#str}}support_team, local_academic_ticket_system{{/str}}{{/is_manager_reply}}{{^is_manager_reply}}{{#str}}student, local_academic_ticket_system{{/str}}{{/is_manager_reply}}</p>
                                    </div>
                                </div>
                                <div class="text-xs font-medium text-gray-500 bg-white/50 px-2 py-1 rounded-lg">
                                    {{time}}
                                </div>
                            </div>
                            <div class="text-gray-800 leading-relaxed prose prose-sm max-w-none">
                                {{{message}}}
                            </div>

                            {{#has_reply_attachments}}
                                <div class="mt-4 pt-3 border-t border-gray-400/20">
                                    <p class="text-xs font-bold text-gray-500 mb-2">{{#str}}attached_files, local_academic_ticket_system{{/str}}</p>
                                    <div class="flex flex-wrap gap-2 items-center">
                                        {{#reply_attachments}}
                                            {{#is_image}}
                                                <div onclick="openImageModal('{{url}}')" class="inline-flex items-center gap-2 px-3 py-1 bg-white/60 rounded-lg text-xs font-bold text-primary-solid hover:bg-brand-light transition-colors cursor-pointer hover-border-secondary hover-text-secondary border border-transparent shadow-sm">
                                                    <i class="fas fa-image"></i> {{name}} ({{#str}}view, local_academic_ticket_system{{/str}})
                                                </div>
                                            {{/is_image}}

                                            {{#is_audio}}
                                                <div class="w-full sm:w-auto min-w-[200px] bg-white/60 rounded-lg p-2 border border-transparent hover-border-secondary shadow-sm">
                                                    <p class="text-[10px] font-bold text-gray-600 mb-1 truncate" title="{{name}}"><i class="fas fa-microphone mr-1 text-primary-solid"></i> {{name}}</p>
                                                    <audio controls class="w-full ats-audio-player">
                                                        <source src="{{url}}">
                                                    </audio>
                                                </div>
                                            {{/is_audio}}

                                            {{^is_image}}
                                                {{^is_audio}}
                                                    <a href="{{url}}" target="_blank" class="inline-flex items-center gap-2 px-3 py-1 bg-white/60 rounded-lg text-xs font-bold text-primary-solid hover:bg-brand-light transition-colors text-decoration-none hover-border-secondary hover-text-secondary border border-transparent shadow-sm">
                                                        <i class="fas fa-file"></i> {{name}}
                                                    </a>
                                                {{/is_audio}}
                                            {{/is_image}}
                                        {{/reply_attachments}}
                                    </div>
                                </div>
                            {{/has_reply_attachments}}
                        </div>
                    {{/replies}}

                    {{^replies}}
                        <div class="flex flex-col items-center justify-center p-12 bg-white/30 rounded-2xl border border-dashed border-brand-light text-center hover-border-secondary transition-colors">
                            <div class="w-16 h-16 bg-brand-light rounded-full flex items-center justify-center text-primary-solid mb-4 text-2xl">
                                <i class="fas fa-comment-slash"></i>
                            </div>
                            <h2 class="text-lg font-bold text-gray-700">{{#str}}no_replies_message, local_academic_ticket_system{{/str}}</h2>
                            <p class="text-gray-500 text-sm mt-1">{{#str}}start_reply, local_academic_ticket_system{{/str}}</p>
                        </div>
                    {{/replies}}
                </div>

                {{#can_rate}}
                    <div class="glass-panel rounded-3xl p-8 border-t-4 border-brand shadow-xl">
                        <div class="flex flex-col items-center text-center">
                            <div class="w-16 h-16 bg-brand-light rounded-full flex items-center justify-center text-secondary-solid mb-4">
                                <i class="fas fa-star text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-black text-gray-800 mb-2">{{#str}}experience_question, local_academic_ticket_system{{/str}}</h3>
                            <p class="text-sm text-gray-500 mb-6 font-medium">{{#str}}feedback_help, local_academic_ticket_system{{/str}}</p>

                            <form method="post" action="view.php?id={{ticket.id}}&action=submit_feedback" class="w-full max-w-md">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">

                            <div class="rating-group mb-6">
                                {{#rating_options}}
                                    <input type="radio" id="star{{val}}" name="rating" value="{{val}}" required>
                                    <label for="star{{val}}">
                                        <i class="fas fa-star"></i>
                                    </label>
                                {{/rating_options}}
                            </div>

                            <textarea name="feedback_comment"
                                      class="w-full p-4 rounded-2xl border border-gray-200 bg-white/50 focus-ring-brand focus:border-brand outline-none text-sm font-medium mb-4 transition-all"
                                      placeholder="{{#str}}feedback_placeholder, local_academic_ticket_system{{/str}}"></textarea>

                            <button type="submit" class="btn-secondary-solid w-full py-4 rounded-2xl text-white font-bold shadow-lg shadow-brand">
                                <i class="fas fa-paper-plane"></i> {{#str}}submit_feedback, local_academic_ticket_system{{/str}}
                            </button>
                            </form>
                        </div>
                    </div>
                {{/can_rate}}

                {{#has_feedback}}
                    <div class="glass-panel rounded-3xl p-6 bg-gradient-to-r from-emerald-50 to-white border-r-8 border-emerald-500 shadow-lg">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-emerald-100 rounded-2xl flex items-center justify-center text-emerald-600">
                                <i class="fas fa-check-circle text-xl"></i>
                            </div>
                            <div>
                                <h4 class="font-black text-gray-800">{{#str}}feedback_submitted, local_academic_ticket_system{{/str}}</h4>
                                <div class="flex text-amber-500 my-1">
                                    {{#feedback_data.stars}}<i class="fas fa-star text-xs"></i>{{/feedback_data.stars}}
                                </div>
                                {{#feedback_data.comment}}
                                    <p class="text-xs text-gray-600 font-medium italic mt-2 bg-white/50 p-3 rounded-lg border border-white">"{{.}}"</p>
                                {{/feedback_data.comment}}
                            </div>
                        </div>
                    </div>
                {{/has_feedback}}

                {{^ticket.status_closed}}
                    <div class="glass-panel rounded-3xl p-8 border-t-4 border-brand">
                        <h3 class="text-xl font-bold mb-6 text-gray-800 flex items-center gap-2">
                            <i class="fas fa-pen text-primary-solid"></i> {{#str}}add_reply_heading, local_academic_ticket_system{{/str}}
                        </h3>

                        <div id="presence-container" class="hidden mb-6">
                            {{#show_presence_list}}
                                <div class="presence-wrapper">
                                    <div class="presence-indicator">
                                        <div class="pulsing-dot"></div>
                                        <span class="presence-text">{{#str}}live_viewing, local_academic_ticket_system{{/str}}</span>
                                    </div>
                                    <div id="presence-list" class="presence-avatars">
                                    </div>
                                </div>
                            {{/show_presence_list}}
                        </div>

                        <form method="post" action="view.php?id={{ticket.id}}" enctype="multipart/form-data">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">

                        <div class="mb-6 bg-white/60 rounded-xl p-1 backdrop-blur-sm">
                            {{{editor_html}}}
                        </div>

                        <div class="mb-6">
                            <label class="block text-sm font-bold text-gray-600 mb-2 flex items-center gap-2">
                                <i class="fas fa-microphone text-primary-solid"></i> {{#str}}record_voice_note, local_academic_ticket_system{{/str}}
                            </label>
                            <div class="glass-panel rounded-2xl p-4 flex items-center justify-between gap-4 border-dashed border-2 border-brand-light">
                                <div class="flex items-center gap-3">
                                    <button type="button" id="startRecord" class="w-12 h-12 rounded-full bg-brand-light text-brand flex items-center justify-center hover:bg-brand hover:text-white transition-all shadow-md hover:shadow-brand">
                                        <i class="fas fa-microphone" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" id="stopRecord" class="hidden w-12 h-12 rounded-full bg-red-500 text-white flex items-center justify-center shadow-lg shadow-red-500/30">
                                        <i class="fas fa-stop" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" id="cancelRecord" class="hidden w-10 h-10 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center hover:bg-red-100 hover:text-red-500 transition-all shadow-sm">
                                        <i class="fas fa-trash" aria-hidden="true"></i>
                                    </button>
                                    <div id="recordingStatus" class="text-sm font-bold text-gray-500">
                                        {{#str}}click_to_record, local_academic_ticket_system{{/str}}
                                    </div>
                                </div>
                                <div id="audioPreviewContainer" class="hidden flex-1">
                                    <audio id="audioPlayback" controls class="w-full h-8 outline-none"></audio>
                                </div>
                            </div>
                            <input type="file" id="voice_note_input" name="reply_voice" class="hidden" accept="audio/*">
                        </div>

                        <div class="mb-6">
                            <label class="block text-sm font-bold text-gray-600 mb-2 flex items-center gap-2">
                                <i class="fas fa-paperclip text-secondary-solid"></i> {{#str}}attach_files_optional, local_academic_ticket_system{{/str}}
                            </label>

                            <div id="drop-zone" class="file-upload-zone group transition-all duration-300 hover-border-secondary">
                                <div class="flex flex-col items-center justify-center py-8 text-center" id="upload-placeholder">
                                    <div class="upload-icon-wrapper mb-4 group-hover:bg-brand-light transition-colors">
                                        <i class="fas fa-cloud-upload-alt text-3xl text-primary-solid group-hover-text-secondary transition-transform"></i>
                                    </div>
                                    <p class="text-sm font-bold text-gray-500 group-hover-text-secondary transition-colors" id="file-chosen-text">
                                        {{#str}}click_to_upload, local_academic_ticket_system{{/str}}
                                    </p>
                                    <p class="text-xs text-gray-400 mt-1">{{#str}}allowed_file_types, local_academic_ticket_system{{/str}}</p>
                                </div>

                                <div id="selected-files-list" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-3 p-4">
                                </div>

                                <input type="file" id="reply_file_input" name="reply_files[]" multiple class="absolute inset-0 opacity-0 cursor-pointer">
                            </div>
                        </div>

                        <button type="submit" class="btn-primary-solid w-full sm:w-auto px-8 py-3.5 rounded-2xl text-white font-bold text-lg shadow-lg shadow-brand">
                            <i class="fas fa-paper-plane"></i> {{#str}}send_reply_button, local_academic_ticket_system{{/str}}
                        </button>
                        </form>
                    </div>
                {{/ticket.status_closed}}
            </div>


{{#js}}
    require([
    'jquery',
    'core/str',
    'local_academic_ticket_system/view_interactions',
    'local_academic_ticket_system/presence'
    ], function($, str, viewInteractions, presence) {
    viewInteractions.init();
    presence.initHeartbeat({{ticketid}});

    window.openImageModal = function(src) {
    var modal = $('#imageModal');
    var modalImg = $('#modalImage');
    var modalDownload = $('#modalDownload');
    modalImg.attr('src', src);
    modalDownload.attr('href', src);
    modal.addClass('active');
    };

    window.closeImageModal = function() {
    var modal = $('#imageModal');
    modal.removeClass('active');
    setTimeout(function() {
    $('#modalImage').attr('src', 'about:blank');
    $('#modalDownload').attr('href', '#');
    }, 300);
    };

    var searchInput = $('#assignee_search');
    var dropdownList = $('#assignee_list');
    var hiddenInput = $('#assigned_to_input');
    var options = $('.assignee-option');

    searchInput.on('focus', function() {
    dropdownList.removeClass('hidden');
    searchInput.val('');
    options.show();
    });

    searchInput.on('keyup', function() {
    var searchTerm = $(this).val().toLowerCase();
    options.each(function() {
    var searchData = $(this).attr('data-search').toLowerCase();
    if (searchData.indexOf(searchTerm) > -1) {
    $(this).show();
    } else {
    $(this).hide();
    }
    });
    });

    options.on('click', function() {
    var val = $(this).attr('data-value');
    var name = $(this).find('p.font-bold').text();
    hiddenInput.val(val);
    searchInput.val(name);
    dropdownList.addClass('hidden');
    });

    $(document).on('click', function(e) {
    if (!$(e.target).closest('#assignee_dropdown_container').length) {
    dropdownList.addClass('hidden');
    if (searchInput.val() === '') {
    var selectedOption = options.filter('[data-value="' + hiddenInput.val() + '"]');
    if (selectedOption.length) {
    searchInput.val(selectedOption.find('p.font-bold').text());
    } else if (hiddenInput.val() === '0') {
    searchInput.val('{{#str}}unassigned, local_academic_ticket_system{{/str}}');
    }
    }
    }
    });

    window.playAudioModal = function(url, name) {
    if (typeof window.Swal !== 'undefined') {
    var htmlContent = '<div class="mt-4 flex justify-center"><audio controls autoplay class="w-full max-w-sm audio-player-custom">';
        htmlContent += '<source src="' + url + '" type="audio/webm">{{#str}}browser_no_audio, local_academic_ticket_system{{/str}}</audio></div>';

    window.Swal.fire({
    title: '<div class="text-xl font-extrabold text-gray-800 mb-2">' + name + '</div>',
    html: htmlContent,
    showConfirmButton: true,
    confirmButtonText: '{{#str}}close, local_academic_ticket_system{{/str}}',
    customClass: {
    popup: 'rounded-[2rem] p-6 shadow-2xl border border-gray-100',
    confirmButton: 'text-white font-bold py-2.5 px-6 rounded-xl border-0 mt-4'
    },
    buttonsStyling: false,
    didOpen: () => {
    const confirmBtn = window.Swal.getConfirmButton();
    if (confirmBtn) {
    confirmBtn.style.backgroundColor = 'var(--ats-primary)';
    }
    }
    }).catch(function() {
    return false;
    });
    } else {
    window.open(url, '_blank');
    }
    };

    let mediaRecorder;
    let audioChunks = [];

    $('#startRecord').on('click', async function() {
    if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
    try {
    const stream = await navigator.mediaDevices.getUserMedia({audio: true});
    mediaRecorder = new window.MediaRecorder(stream);
    audioChunks = [];

    mediaRecorder.ondataavailable = e => audioChunks.push(e.data);

    mediaRecorder.onstop = () => {
    const audioBlob = new window.Blob(audioChunks, {type: 'audio/webm'});
    const audioUrl = window.URL.createObjectURL(audioBlob);
    $('#audioPlayback').attr('src', audioUrl);
    $('#audioPreviewContainer').removeClass('hidden');

    let file = new window.File([audioBlob], "voice_note.webm", {type: "audio/webm"});
    let container = new window.DataTransfer();
    container.items.add(file);
    document.getElementById('voice_note_input').files = container.files;

    $('#recordingStatus').text('{{#str}}ready, local_academic_ticket_system{{/str}}')
    .removeClass('text-red-500').addClass('text-green-600');
    $('#startRecord').removeClass('hidden');
    $('#stopRecord').addClass('hidden');
    $('#cancelRecord').removeClass('hidden');
    };

    mediaRecorder.start();
    $(this).addClass('hidden');
    $('#stopRecord').removeClass('hidden');
    $('#cancelRecord').addClass('hidden');
    $('#audioPreviewContainer').addClass('hidden');
    $('#recordingStatus').text('{{#str}}recording_now, local_academic_ticket_system{{/str}}')
    .removeClass('text-green-600 text-gray-500').addClass('text-red-500');
    } catch (err) {
    str.get_string('mic_access_denied', 'local_academic_ticket_system').done(function(locString) {
    if (typeof window.Swal !== 'undefined') {
    window.Swal.fire({
    icon: 'error',
    title: 'Oops...',
    text: locString
    });
    }
    }).fail(function() {
    // Handle failure silently
    });
    }
    }
    });

    $('#stopRecord').on('click', function() {
    if (mediaRecorder) {
    mediaRecorder.stop();
    }
    });

    $('#cancelRecord').on('click', function() {
    document.getElementById('voice_note_input').value = "";
    $('#audioPreviewContainer').addClass('hidden');
    $('#audioPlayback').attr('src', '');
    $(this).addClass('hidden');
    $('#startRecord').removeClass('hidden');
    $('#recordingStatus').text('{{#str}}click_to_record, local_academic_ticket_system{{/str}}')
    .removeClass('text-green-600 text-red-500').addClass('text-gray-500');
    });

    var fileInput = document.getElementById('reply_file_input');
    var fileList = document.getElementById('selected-files-list');
    var uploadPlaceholder = document.getElementById('upload-placeholder');
    var dataTransfer = new window.DataTransfer();

    $(fileInput).on('change', function(e) {
    var files = e.target.files;
    for (var i = 0; i < files.length; i++) {
    dataTransfer.items.add(files[i]);
    }
    updateFileList();
    });

    function updateFileList() {
    fileInput.files = dataTransfer.files;
    $(fileList).empty();

    if (dataTransfer.files.length > 0) {
    $(uploadPlaceholder).addClass('hidden');
    $(fileList).removeClass('hidden');

    $.each(dataTransfer.files, function(index, file) {
    var size = (file.size / 1024 / 1024).toFixed(2) + ' MB';
    var html = '<div class="flex items-center justify-between bg-white/80 p-2 rounded-lg border border-gray-200 shadow-sm">';
        html += '<div class="flex items-center gap-2 overflow-hidden"><i class="fas fa-file text-primary-solid"></i>';
            html += '<div class="min-w-0"><p class="text-xs font-bold text-gray-700 truncate">' + file.name + '</p>';
                html += '<p class="text-[10px] text-gray-500">' + size + '</p></div></div>';

        var btnClass = 'remove-file-btn w-6 h-6 z-10 relative rounded-full bg-red-100 text-red-500 ';
        btnClass += 'flex items-center justify-center hover:bg-red-500 hover:text-white transition-colors cursor-pointer';

        html += '<button type="button" title="{{#str}}remove_file, local_academic_ticket_system{{/str}}" ';
        html += 'class="' + btnClass + '" data-index="' + index + '">';
        html += '<i class="fas fa-times text-xs pointer-events-none"></i></button></div>';
    $(fileList).append(html);
    });

    $('.remove-file-btn').on('click', function(e) {
    e.preventDefault();
    var idx = parseInt($(this).attr('data-index'));
    var newDt = new window.DataTransfer();
    for (var i = 0; i < dataTransfer.files.length; i++) {
    if (i !== idx) {
    newDt.items.add(dataTransfer.files[i]);
    }
    }
    dataTransfer = newDt;
    updateFileList();
    });
    } else {
    $(uploadPlaceholder).removeClass('hidden');
    $(fileList).addClass('hidden');
    }
    }
    });
{{/js}}
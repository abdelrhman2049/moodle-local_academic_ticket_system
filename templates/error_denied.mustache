{{!
    @template local_academic_ticket_system/error_denied

    Example context (json):
    {
        "home_url": "#"
    }
}}
<div class="ats-container ats-error-wrapper">
    <div class="glass-error">
        <div class="icon-box">
            <i class="fas fa-lock text-4xl text-primary-solid"></i>
        </div>

        <h2 class="text-3xl font-extrabold text-gray-800 mb-4">
            {{#str}}nopermission, local_academic_ticket_system{{/str}}
        </h2>

        <p class="text-gray-500 mb-8 text-lg font-medium leading-relaxed">
            {{#str}}nopermission_desc, local_academic_ticket_system{{/str}}
        </p>

        <a href="{{home_url}}" class="btn-primary-solid w-full py-4 rounded-2xl font-bold text-lg text-white text-decoration-none shadow-brand block">
            <i class="fas fa-arrow-left"></i> {{#str}}back_to_home, local_academic_ticket_system{{/str}}
        </a>
    </div>
</div>